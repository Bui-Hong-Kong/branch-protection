{
  "name": "sockshop-frontend",
  "version": "1.0.0",
  "description": "Sock Shop web BFF (Express) + React storefront",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm install --prefix web && npm run build --prefix web",
    "test": "istanbul cover node_modules/.bin/_mocha -- test/*_test.js test/api/*_test.js",
    "lint": "eslint . --max-warnings 0"
  },
  "license": "MIT",
  "dependencies": {
    "async": "^1.5.2",
    "body-parser": "^1.20.3",
    "connect-redis": "^3.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "finalhandler": "^1.3.1",
    "morgan": "^1.10.0",
    "prom-client": "^6.3.0",
    "request": "^2.88.2",
    "serve-static": "^1.16.2"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "chai-http": "^3.0.0",
    "istanbul": "^0.4.4",
    "mocha": "^3.0.0",
    "mocha-junit-reporter": "^1.12.1",
    "mongodb": "^2.2.5",
    "sinon": "^1.17.5"
  }
}
