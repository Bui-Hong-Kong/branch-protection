FROM node:20-alpine

ENV NODE_ENV=production
ENV PORT=8079

RUN addgroup -S mygroup && adduser -S -G mygroup myuser \
  && mkdir -p /usr/src/app \
  && chown -R myuser /usr/src/app

WORKDIR /usr/src/app

COPY package.json yarn.lock ./
RUN chown myuser:mygroup package.json yarn.lock

USER myuser
RUN yarn install --frozen-lockfile || yarn install

COPY --chown=myuser:mygroup . .

EXPOSE 8079
CMD ["npm", "start"]
